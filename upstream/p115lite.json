  "entry": {
    "name": "115Lite",
    "description": "115Lite 自用版，感谢原作者 DDSRem、zkmydgth",
    "labels": "115,云盘,STRM,整理",
    "version": "3.0.3",
    "icon": "https://raw.githubusercontent.com/madrays/MoviePilot-Plugins/main/icons/p115lite.png",
    "author": "madrays",
    "level": 1,
    "release": true,
    "history": {
      "v3.0.3": "跟进 MoviePilot 新版 durable 整理契约：插件接管前原子注销宿主准入责任，注销失败自动回退原生整理；修复订阅整理每15秒回放、缺少 execution checkpoint 和活动任务冲突。",
      "v3.0.2": "适配 MoviePilot V3.1.2+ durable 整理重试接口，新宿主使用 _request_durable_transfer_retry，旧宿主保留 retry_scheduler 回退，避免失败任务每 15 秒重复报错。",
      "v3.0.1": "改用 GitHub Release 整包安装，仅携带 Debian x86_64 / Python 3.14 的 Rust 加速轮子；完善 V3 durable 整理接管、原版配置迁移、短命令、图标与使用文档。",
      "v3.0.0": "基于 DDSRem 与 zkmydgth 的现有实现做定点裁剪并合并 115Lite 存储；仅移除阿里云、签到、侧边栏、多端播放、频道搜索、捐赠、上传和 FUSE，其余原版功能保留；固定 p115client 与 concurrenttools 兼容依赖。"
    },
    "system_version": ">=3.0.0"
  },
